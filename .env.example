# ══════════════════════════════════════════════════
# Turath Research — Environment Variables
# ══════════════════════════════════════════════════
# Copy to .env and fill in the values
# Coolify: add these in the Environment Variables section

# ── Required ──────────────────────────────────────
POSTGRES_DB=turath
POSTGRES_USER=turath
POSTGRES_PASSWORD=                # Required — use a strong password
JWT_SECRET=                       # Required — use: openssl rand -hex 32

# ── Server ────────────────────────────────────────
SERVER_PORT=8080
FRONTEND_URL=https://turath.example.com
NEXT_PUBLIC_API_URL=/api
ALLOWED_ORIGINS=https://turath.example.com

# ── Academic APIs ─────────────────────────────────
SCOPUS_API_KEY=
CROSSREF_MAILTO=admin@university.edu
SERPAPI_KEY=

# ── ORCID ─────────────────────────────────────────
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# ── AI (DeepSeek) ─────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Auto-configured (Docker network) ─────────────
# Do not change these — set automatically by docker-compose
# DATABASE_URL=postgresql://turath:***@postgres:5432/turath?sslmode=disable
# REDIS_URL=redis://redis:6379

# ── Sign in with Google (university accounts only) ──
# Create an OAuth client of type "Web application" in Google Cloud Console and add every
# site origin (e.g. http://localhost:3001, https://research.uoturath.edu.iq) under
# "Authorized JavaScript origins". No redirect URI is needed.
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_DOMAIN=uoturath.edu.iq
# Open email+password sign-up; keep false in production.
ALLOW_PASSWORD_REGISTER=false
